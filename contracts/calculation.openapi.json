{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "location",
          "reason"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Estimate": {
        "additionalProperties": false,
        "properties": {
          "assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "destination_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Destination Id",
            "type": "string"
          },
          "destination_position_pc": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Destination Position Pc",
            "type": "array"
          },
          "distance_ly": {
            "minimum": 0.0,
            "title": "Distance Ly",
            "type": "number"
          },
          "distance_pc": {
            "minimum": 0.0,
            "title": "Distance Pc",
            "type": "number"
          },
          "duration_julian_years": {
            "minimum": 0.0,
            "title": "Duration Julian Years",
            "type": "number"
          },
          "model_version": {
            "const": "constant-speed-v1",
            "title": "Model Version",
            "type": "string"
          },
          "origin_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Origin Id",
            "type": "string"
          },
          "origin_position_pc": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Origin Position Pc",
            "type": "array"
          },
          "snapshot_id": {
            "examples": [
              "gcns-edr3-20261013-20271720"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "speed_fraction_c": {
            "maximum": 0.5,
            "minimum": 0.001,
            "title": "Speed Fraction C",
            "type": "number"
          },
          "speed_km_s": {
            "minimum": 0.0,
            "title": "Speed Km S",
            "type": "number"
          }
        },
        "required": [
          "snapshot_id",
          "origin_id",
          "destination_id",
          "origin_position_pc",
          "destination_position_pc",
          "distance_pc",
          "distance_ly",
          "speed_fraction_c",
          "speed_km_s",
          "duration_julian_years",
          "model_version",
          "assumptions"
        ],
        "title": "Estimate",
        "type": "object"
      },
      "EstimateRequest": {
        "additionalProperties": false,
        "properties": {
          "destination_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Destination Id",
            "type": "string"
          },
          "origin_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Origin Id",
            "type": "string"
          },
          "snapshot_id": {
            "examples": [
              "gcns-edr3-20261013-20271720"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "speed_fraction_c": {
            "examples": [
              0.1
            ],
            "maximum": 0.5,
            "minimum": 0.001,
            "title": "Speed Fraction C",
            "type": "number"
          }
        },
        "required": [
          "snapshot_id",
          "origin_id",
          "destination_id",
          "speed_fraction_c"
        ],
        "title": "EstimateRequest",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "active_snapshot": {
            "anyOf": [
              {
                "examples": [
                  "gcns-edr3-20261013-20271720"
                ],
                "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Snapshot"
          },
          "readiness": {
            "title": "Readiness",
            "type": "boolean"
          },
          "release_id": {
            "pattern": "^(r[0-9]+-a[0-9]+-[a-f0-9]{12}|local-[a-f0-9]{12})$",
            "title": "Release Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "service": {
            "enum": [
              "catalog",
              "search",
              "atlas_map",
              "snapshot",
              "calculation",
              "journey"
            ],
            "title": "Service",
            "type": "string"
          },
          "source_sha": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Sha",
            "type": "string"
          }
        },
        "required": [
          "service",
          "source_sha",
          "release_id",
          "schema_version",
          "readiness",
          "active_snapshot"
        ],
        "title": "Meta",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Versioned local-catalog API. Immutable snapshots and anonymous constant-speed journeys.",
    "title": "Stellar Atlas Calculation",
    "version": "1.0.0"
  },
