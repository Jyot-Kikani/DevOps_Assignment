{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellar-atlas.invalid/contracts/public-config.schema.json",
  "title": "Public nonsecret application configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["APP_ENV", "LOG_LEVEL", "CATALOG_SNAPSHOT_ID", "SHARE_RETENTION_DAYS"],
  "properties": {
    "APP_ENV": {"enum": ["dev", "ci", "demo"]},
    "LOG_LEVEL": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
    "SOURCE_SHA": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "RELEASE_ID": {"type": "string", "pattern": "^(local-[a-f0-9]{12}|r[0-9]+-a[0-9]+-[a-f0-9]{12})$"},
    "CATALOG_SNAPSHOT_ID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "PUBLIC_BASE_URL": {"type": ["string", "null"], "pattern": "^https://[a-z0-9-]+\\.trycloudflare\\.com$"},
    "SHARE_RETENTION_DAYS": {"const": 30},
    "GITOPS_ENABLED": {"type": "boolean"},
    "fixture": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"APP_ENV": {"const": "demo"}}}, "then": {"properties": {"fixture": {"const": false}}}}]
}
