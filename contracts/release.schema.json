{
  "$defs": {
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "catalog_schema": {
          "const": 1,
          "title": "Catalog Schema",
          "type": "integer"
        },
        "journey_schema": {
          "const": 1,
          "title": "Journey Schema",
          "type": "integer"
        },
        "model": {
          "const": "constant-speed-v1",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "catalog_schema",
        "journey_schema",
        "model"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "fixture": {
          "const": false,
          "title": "Fixture",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "raw_sha256",
        "fixture"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "properties": {
        "local_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Tag"
        },
        "manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "ref": {
          "pattern": "^(sha256:[a-f0-9]{64}|ghcr\\.io/[a-z0-9-]+/stellar-atlas-(web|catalog|journey|importer)@sha256:[a-f0-9]{64})$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "manifest_digest"
      ],
      "title": "Image",
      "type": "object"
    },
    "Images": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/Image"
        },
        "importer": {
          "$ref": "#/$defs/Image"
        },
        "journey": {
          "$ref": "#/$defs/Image"
        },
        "web": {
          "$ref": "#/$defs/Image"
        }
      },
      "required": [
        "web",
        "catalog",
        "journey",
        "importer"
      ],
      "title": "Images",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "images": {
      "$ref": "#/$defs/Images"
    },
    "release_id": {
      "pattern": "^(r[0-9]+-a[0-9]+-[a-f0-9]{12}|local-[a-f0-9]{12})$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_dirty": {
      "const": false,
      "default": false,
      "title": "Source Dirty",
      "type": "boolean"
    },
    "source_repository": {
      "pattern": "^[A-Za-z0-9-]+/DevOps_Assignment$",
      "title": "Source Repository",
      "type": "string"
    },
    "source_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Sha",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "source_sha",
    "source_repository",
    "created_at",
    "dataset",
    "images",
    "compatibility"
  ],
  "title": "Release",
  "type": "object"
}
