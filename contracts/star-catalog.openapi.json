{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "location",
          "reason"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FrozenPosition": {
        "additionalProperties": false,
        "properties": {
          "position_pc": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Position Pc",
            "type": "array"
          },
          "source_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "position_pc"
        ],
        "title": "FrozenPosition",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "active_snapshot": {
            "anyOf": [
              {
                "examples": [
                  "gcns-edr3-20261013-20271720"
                ],
                "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Snapshot"
          },
          "readiness": {
            "title": "Readiness",
            "type": "boolean"
          },
          "release_id": {
            "pattern": "^(r[0-9]+-a[0-9]+-[a-f0-9]{12}|local-[a-f0-9]{12})$",
            "title": "Release Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "service": {
            "enum": [
              "catalog",
              "search",
              "atlas_map",
              "snapshot",
              "calculation",
              "journey"
            ],
            "title": "Service",
            "type": "string"
          },
          "source_sha": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Sha",
            "type": "string"
          }
        },
        "required": [
          "service",
          "source_sha",
          "release_id",
          "schema_version",
          "readiness",
          "active_snapshot"
        ],
        "title": "Meta",
        "type": "object"
      },
