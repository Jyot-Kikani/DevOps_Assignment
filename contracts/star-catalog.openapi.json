        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "bp_magnitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bp Magnitude"
          },
          "color_index": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Index"
          },
          "dec_deg": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dec Deg"
          },
          "distance_ly": {
            "minimum": 0.0,
            "title": "Distance Ly",
            "type": "number"
          },
          "distance_p16_pc": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance P16 Pc"
          },
          "distance_p84_pc": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance P84 Pc"
          },
          "distance_pc": {
            "minimum": 0.0,
            "title": "Distance Pc",
            "type": "number"
          },
          "g_magnitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "G Magnitude"
          },
          "ordinal": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Ordinal",
            "type": "integer"
          },
          "position_pc": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Position Pc",
            "type": "array"
          },
          "ra_deg": {
            "anyOf": [
              {
                "exclusiveMaximum": 360.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ra Deg"
          },
          "rp_magnitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rp Magnitude"
          },
          "snapshot_id": {
            "examples": [
              "gcns-edr3-20261013-20271720"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_id": {
            "examples": [
              "5853498713190525696",
              "sun"
            ],
            "pattern": "^(sun|[0-9]{1,20})$",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "source_id",
          "ordinal",
          "aliases",
          "position_pc",
          "distance_pc",
          "distance_ly",
          "distance_p16_pc",
          "distance_p84_pc",
          "ra_deg",
          "dec_deg",
          "g_magnitude",
          "bp_magnitude",
          "rp_magnitude",
          "color_index"
        ],
        "title": "Star",
        "type": "object"
      }
