            "description": "Invalid body fields",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "maxLength": 64,
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit; Retry-After header",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "maxLength": 64,
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Dependency unavailable",
