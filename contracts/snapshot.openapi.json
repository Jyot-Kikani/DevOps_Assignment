{
  "components": {
    "schemas": {
      "Counts": {
        "additionalProperties": false,
        "properties": {
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          },
          "within_100pc": {
            "minimum": 0.0,
            "title": "Within 100Pc",
            "type": "integer"
          },
          "within_25ly": {
            "minimum": 0.0,
            "title": "Within 25Ly",
            "type": "integer"
          },
          "within_50ly": {
            "minimum": 0.0,
            "title": "Within 50Ly",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "within_100pc",
          "within_50ly",
          "within_25ly"
        ],
        "title": "Counts",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "location",
          "reason"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "active_snapshot": {
            "anyOf": [
              {
                "examples": [
                  "gcns-edr3-20261013-20271720"
                ],
                "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Snapshot"
          },
          "readiness": {
            "title": "Readiness",
            "type": "boolean"
          },
          "release_id": {
            "pattern": "^(r[0-9]+-a[0-9]+-[a-f0-9]{12}|local-[a-f0-9]{12})$",
            "title": "Release Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "service": {
            "enum": [
              "catalog",
              "search",
              "atlas_map",
              "snapshot",
              "calculation",
              "journey"
            ],
            "title": "Service",
            "type": "string"
          },
          "source_sha": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Sha",
            "type": "string"
          }
        },
        "required": [
          "service",
          "source_sha",
          "release_id",
          "schema_version",
          "readiness",
          "active_snapshot"
        ],
        "title": "Meta",
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "citation_urls": {
            "items": {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            "title": "Citation Urls",
            "type": "array"
          },
          "counts": {
            "$ref": "#/components/schemas/Counts"
          },
          "epoch": {
            "const": 2016.0,
            "title": "Epoch",
            "type": "number"
          },
          "license_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "License Url",
            "type": "string"
          },
          "map_format_version": {
            "const": 1,
            "title": "Map Format Version",
            "type": "integer"
          },
          "max_map_radius_pc": {
            "const": 100,
            "title": "Max Map Radius Pc",
            "type": "integer"
          },
          "raw_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Raw Sha256",
            "type": "string"
          },
          "snapshot_id": {
            "examples": [
              "gcns-edr3-20261013-20271720"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "transform_version": {
            "const": "1",
            "title": "Transform Version",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "epoch",
          "raw_sha256",
          "source_url",
          "citation_urls",
          "license_url",
          "counts",
          "max_map_radius_pc",
          "map_format_version",
          "transform_version"
        ],
        "title": "Snapshot",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Versioned local-catalog API. Immutable snapshots and anonymous constant-speed journeys.",
    "title": "Stellar Atlas Snapshot",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
