{
  "uid": "stellar-atlas",
  "title": "Stellar Atlas \u2014 local services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"stellar-apis\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests by service and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service, status) (stellar_http_requests_total)",
          "refId": "A",
          "legendFormat": "{{service}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request duration (p95 seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(stellar_http_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{service}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Database failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (stellar_database_failures_total) or on (service) (0 * sum by (service) (stellar_http_requests_total))",
          "refId": "A",
          "legendFormat": "{{service}} {{status}} {{instance}}"
        }
      ]
    }
  ]
}
