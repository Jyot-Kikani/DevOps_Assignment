APP_ENV=dev
LOG_LEVEL=INFO
SHARE_RETENTION_DAYS=30
CATALOG_INTERNAL_URL=http://catalog:8000
CATALOG_SNAPSHOT_ID=gcns-edr3-20261013-20271720
GITOPS_ENABLED=false
# Populate release identity when building; no invented source SHA or public URL.
# Database/Grafana credentials are generated under .local/secrets in P04.
# API/Job processes require their own role only, as a DSN or protected DSN file:
# CATALOG_READER_DSN_FILE, CATALOG_WRITER_DSN_FILE (migration/import only)
# JOURNEY_DSN_FILE, JOURNEY_OWNER_DSN_FILE (migration only)
# Format: postgresql+psycopg://<role>:<secret>@postgres/<own_database>
