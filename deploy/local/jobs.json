                  }
                },
                "command": [
                  "python",
                  "-m",
                  "stellar_catalog.migrate"
                ],
                "env": [
                  {
                    "name": "CATALOG_WRITER_DSN_FILE",
                    "value": "/run/secrets/catalog_writer_dsn"
