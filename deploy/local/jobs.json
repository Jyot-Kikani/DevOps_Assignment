{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "bootstrap",
        "namespace": "stellar-atlas",
        "labels": {
          "app": "bootstrap",
          "app.kubernetes.io/part-of": "stellar-atlas"
        }
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 600,
        "template": {
          "spec": {
            "automountServiceAccountToken": false,
            "restartPolicy": "Never",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001
            },
            "containers": [
              {
                "name": "importer",
                "image": "IMAGE_IMPORTER",
                "imagePullPolicy": "Never",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "command": [
                  "python",
                  "/app/bootstrap.py"
                ],
                "volumeMounts": [
                  {
                    "name": "secrets",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "secrets",
                "secret": {
                  "secretName": "bootstrap",
                  "defaultMode": 292
                }
              }
            ]
          }
        }
      }
    },
    {
