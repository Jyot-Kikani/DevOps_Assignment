            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001
            },
            "containers": [
              {
                "name": "catalog",
                "image": "IMAGE_CATALOG",
                "imagePullPolicy": "Never",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
