                        "cpu": "50m",
                        "memory": "64Mi"
                      },
                      "limits": {
                        "cpu": "1",
                        "memory": "512Mi"
                      }
                    },
                    "command": [
                      "python",
                      "-c",
                      "import json; from stellar_importer.maintenance import retention; print(json.dumps(retention()))"
                    ],
                    "env": [
                      {
                        "name": "JOURNEY_DSN_FILE",
                        "value": "/run/secrets/journey_app_dsn"
                      }
                    ],
                    "volumeMounts": [
                      {
                        "name": "secrets",
                        "mountPath": "/run/secrets",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
